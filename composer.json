{
    "name": "easysuite/common",
    "description": "Gemeinsame Bausteine der EasySuite-Systeme: OIDC-Login, JWT-Prüfung, S2S-Client, Events",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "ext-openssl": "*",
        "laravel/framework": "^12.0|^13.0",
        "lcobucci/jwt": "^5.5",
        "psr/clock": "^1.0"
    },
    "require-dev": {
        "laravel/pint": "^1.27",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5|^12.5"
    },
    "autoload": {
        "psr-4": {
            "EasySuite\\Common\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EasySuite\\Common\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "EasySuite\\Common\\EasySuiteServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "pint --test"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
